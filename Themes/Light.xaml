<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#FFF4F0EA"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FF1E2B34"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FF55616B"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#FF737E88"/>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C8FFFFFF" Offset="0"/>
        <GradientStop Color="#8CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#66FFFFFF" Offset="0.55"/>
        <GradientStop Color="#2E1E2B34" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#9EFFFFFF"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#2E1E2B34"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFFF775E"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF1E2B34"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EFF775E"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#FF1B8F69"/>
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#261B8F69"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FF9A6410"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#26D9951C"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC53030"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FC53030"/>
    <Color x:Key="Blob1C">#70FF775E</Color>
    <Color x:Key="Blob1T">#00FF775E</Color>
    <Color x:Key="Blob2C">#608B7CF6</Color>
    <Color x:Key="Blob2T">#008B7CF6</Color>
    <Color x:Key="Blob3C">#554C9AFF</Color>
    <Color x:Key="Blob3T">#004C9AFF</Color>
</ResourceDictionary>
