<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#FFEDF4F8"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FF0E2233"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FF4A6074"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#FF6A8094"/>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C8FFFFFF" Offset="0"/>
        <GradientStop Color="#8CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#66FFFFFF" Offset="0.55"/>
        <GradientStop Color="#2E0E2233" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#9EFFFFFF"/>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#2E0E2233"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0068F0"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#260068F0"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0068F0" Offset="0"/>
        <GradientStop Color="#FF00D890" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientVBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#FF0068F0" Offset="0"/>
        <GradientStop Color="#FF00D890" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GoodBrush" Color="#FF008A5A"/>
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#2600C884"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FF9A6410"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#26D9951C"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC53030"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FC53030"/>
    <Color x:Key="Blob1C">#700068F0</Color>
    <Color x:Key="Blob1T">#000068F0</Color>
    <Color x:Key="Blob2C">#6000F1A0</Color>
    <Color x:Key="Blob2T">#0000F1A0</Color>
    <Color x:Key="Blob3C">#5000B8E0</Color>
    <Color x:Key="Blob3T">#0000B8E0</Color>
</ResourceDictionary>
